# phpstudy Nginx 备选配置（Docker nginx 不可用时的方案）
#
# 用法：
#   1. 把本文件复制到 phpstudy nginx 的 vhosts 目录：
#      D:\phpstudy_pro\Extensions\Nginx1.15.11\conf\vhosts\im-web.conf
#   2. 到 phpstudy 面板 → 软件管理 → Nginx → 重启
#   3. 浏览器访问 http://localhost:8081
#
# 注意：本方案不依赖 Docker；api/gateway 仍需用 Docker 或本机进程跑。

server {
    listen 8081;
    server_name localhost;

    # 前端静态产物（npm run build 后的 dist）
    root D:/im-project/im-web/dist;
    index index.html;

    # SPA 路由（刷新不 404）
    location / {
        try_files $uri $uri/ /index.html;
    }

    # REST API 反代到 Go api (:8080)
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # WebSocket 反代到 Go gateway (:9090)
    location /ws {
        proxy_pass http://127.0.0.1:9090;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;          # WS 升级关键
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
