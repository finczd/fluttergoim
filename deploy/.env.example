# ===== 基础设施 =====
MYSQL_PASSWORD=change_me
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ===== 后端（对应 im-server/.env.example）=====
NODE_ID=node-a
HTTP_PORT=8080
WS_PORT=9090
JWT_SECRET=please_change_me_to_a_long_random_string
AUTH_MODE=none
INVITE_CODE_ENABLED=false
REGISTER_ENABLED=true
E2E_ENABLED=false

# 第一个管理员（部署时初始化）
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=Admin@123456

# TRTC（V2.0 使用）
TRTC_APP_ID=
TRTC_SECRET_KEY=

# 阿里云短信（认证模式=sms 时配置）
ALIYUN_SMS_ACCESS_KEY=
ALIYUN_SMS_SECRET_KEY=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# SMTP（认证模式=email 时配置）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 就近接入节点列表
ACCESS_NODES=[{"id":"node-a","name":"主节点","wss":"wss://im.example.com/ws","api":"https://im.example.com","weight":100}]
